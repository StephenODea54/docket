# Ignore everything
*

# But descend into directories
!*/

# But still exclude generated folders
__pycache__/
*.egg-info
*.py[oc]
.venv
build/
dist/
wheels/

# And permit certain files
!.env.example
!.gitignore
!.pre-commit-config.yaml
!.python-version
!LICENSE
!py.typed
!uv.lock

# And file types
!*.css
!*.html
!*.js
!*.md
!*.py
!*.toml
